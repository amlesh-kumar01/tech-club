# Use official Node.js Alpine image for a lightweight footprint
FROM node:20-alpine

# Set working directory
WORKDIR /app

# The node modules and package.json will be available because we mount the volume in docker-compose.
# We also want to ensure we run Next.js in dev mode correctly.

# Expose Next.js default port
EXPOSE 3000

# Run development server
CMD ["npm", "run", "dev"]
